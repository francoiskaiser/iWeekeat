{
  "expo": {
    "name": "iWeekeat",
    "slug": "mealhelper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "iweekeat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iweekeat.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF7A41"
      },
      "package": "com.iweekeat.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF7A41"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/iWeekeat"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42c2e904-2c30-4202-8c1d-89358270b8c5"
      },
      "firebase": {
        "apiKey": "AIzaSyDY5kyOvZsek2G5ecC9VvGaNKtTIF2lYj4",
        "authDomain": "mealhelper-5db87.firebaseapp.com",
        "projectId": "mealhelper-5db87",
        "storageBucket": "mealhelper-5db87.firebasestorage.app",
        "messagingSenderId": "633227445102",
        "appId": "1:633227445102:web:909afa4a6347ec1b6c777f"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "iWeekeat",
      "shortName": "iWeekeat",
      "themeColor": "#FF7A41",
      "backgroundColor": "#ffffff"
    }
  }
}
